{
  "rules": {
    ".read": false,
    ".write": false,

    "config": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "categorias": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "ofertas": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "clientes": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "metricas": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "ofertas": {
        "$ofertaId": {
          "$campo": { ".write": true, ".validate": "newData.isNumber()" }
        }
      },
      "locales": {
        "$localId": {
          "$campo": { ".write": true, ".validate": "newData.isNumber()" }
        }
      },
      "categorias": {
        "$categoriaId": {
          "$campo": { ".write": true, ".validate": "newData.isNumber()" }
        }
      },
      "busquedasSinResultado": {
        "$registroId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['texto', 'fecha'])"
        }
      }
    },

    "admins": {
      ".read": "auth != null",
      ".write": false
    },

    "uidIndex": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "usuarios": {
      ".indexOn": ["username"],
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".read": "root.child('admins').child(auth.uid).val() === true || root.child('usuarios').child($id).child('uid').val() === auth.uid",
        ".write": "root.child('admins').child(auth.uid).val() === true || root.child('usuarios').child($id).child('uid').val() === auth.uid"
      }
    },

    "pedidos": {
      ".indexOn": ["estado", "usuarioAsignado"],
      ".read": "auth != null",
      ".write": "auth != null",
      "$pedidoId": {
        ".validate": "newData.hasChildren(['descripcion'])"
      }
    },

    "liquidaciones": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true",
      "$userId": {
        ".read": "root.child('admins').child(auth.uid).val() === true || root.child('usuarios').child($userId).child('uid').val() === auth.uid"
      }
    },

    "historialLiquidaciones": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "liquidacionAdmin": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },

    "historial": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    }
  }
}
